{
  "name": "40k-reminders",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "bootstrap": "5.3.8",
    "core-js": "^3.49.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "react-modal": "3.16.3",
    "react-router": "8.3.0",
    "react-select": "5.10.2",
    "react-switch": "7.1.0",
    "sass": "^1.102.0"
  },
  "scripts": {
    "brand:icons": "node scripts/brandIcons.mjs",
    "build": "tsc && vite build",
    "data:archive": "node scripts/dataArchive.mjs",
    "data:wh40k11e:candidate": "vite-node --script src/wh40k11e/data/acquireCommand.ts",
    "data:wh40k11e:check-exports": "vite-node --script src/wh40k11e/data/checkExportsCommand.ts",
    "data:wh40k11e:compare": "vite-node --script src/wh40k11e/data/compareCommand.ts",
    "data:wh40k11e:generate": "vite-node --script src/wh40k11e/generate/runtimeCommand.ts",
    "data:wh40k11e:generate:write": "yarn data:wh40k11e:generate --write",
    "data:wh40k11e:index": "vite-node --script src/wh40k11e/data/indexCommand.ts",
    "data:wh40k11e:reminders": "vite-node --script src/wh40k11e/data/remindersCommand.ts",
    "data:wh40k11e:review": "vite-node --script src/wh40k11e/data/reviewCommand.ts",
    "data:wh40k11e:rules": "vite-node --script src/wh40k11e/data/rulesCommand.ts",
    "data:wh40k11e:watch": "vite-node --script src/wh40k11e/data/watchCommand.ts",
    "format": "yarn prettier --write \"**/*.*(js|jsx|mjs|cjs|ts|tsx|mts|cts|json|scss|css|yml|yaml|html)\"",
    "lint": "eslint src --max-warnings 0",
    "prepare": "husky",
    "prepush": "yarn lint && yarn tsc --noEmit && yarn build && yarn test --run",
    "preview": "vite preview",
    "start": "vite",
    "test": "cross-env TZ=UTC vitest",
    "up": "yarn install && yarn upgrade-interactive --latest"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 edge version",
      "last 1 explorer version",
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-modal": "3.16.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "pretty-quick": "^4.2.2",
    "sharp": "^0.35.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^4.1.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "resolutions": {
    "typescript": "5.9.3",
    "@typescript-eslint/parser": "^8.66.0",
    "autoprefixer": "10.4.27",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4"
  }
}
